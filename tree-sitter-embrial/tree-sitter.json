{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "embrial",
      "camelcase": "Embrial",
      "title": "Embrial",
      "scope": "source.embrial",
      "file-types": [
        "ebl"
      ],
      "highlights": ["queries/highlights.scm"],
      "injection-regex": "^embrial$",
      "class-name": "TreeSitterEmbrial"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Embrial grammar for tree-sitter",
    "authors": [
      {
        "name": "Adrian Long",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-embrial",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
